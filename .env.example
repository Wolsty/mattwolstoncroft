# Resend API: required for /api/contact (footer contact form)
RESEND_API_KEY=
CONTACT_EMAIL_TO=wolstoncroft.1@gmail.com
CONTACT_EMAIL_FROM=wolstoncroft.1@gmail.com

# Site-wide password gate. Required by middleware.ts and /api/auth/login.
SITE_PASSWORD=

# Mapbox public token: required for /atlas (the map). Create at https://account.mapbox.com/access-tokens
# Restrict it to your domains (mattwolstoncroft.com, localhost) in the Mapbox dashboard.
MAPBOX_TOKEN=

# Atlas (/atlas) has its own password, separate from SITE_PASSWORD.
ATLAS_PASSWORD=

# Editing the Atlas on the site (owner only). Separate from ATLAS_PASSWORD.
ATLAS_EDIT_PASSWORD=
# Vercel Blob store connected to the project (added automatically when you connect the store).
BLOB_READ_WRITE_TOKEN=
